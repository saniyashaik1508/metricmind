{
  "name": "metricmind",
  "version": "1.0.0",
  "private": true,
  "description": "MetricMind - Agentic Semantic BI Engine",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "node backend/server.js",
    "build": "next build",
    "start": "concurrently -k -n WEB,API -c blue,green \"next start\" \"node backend/server.js\"",
    "lint": "next lint"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "lucide-react": "^0.395.0",
    "duckdb": "^1.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
